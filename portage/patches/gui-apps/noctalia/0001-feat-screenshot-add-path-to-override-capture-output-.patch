 docs/user/ipc/media-and-ui.mdx       |  4 +-
 src/capture/screenshot_service.cpp   | 86 ++++++++++++++++++++++++----
 src/capture/screenshot_service.h     |  1 +
 src/cli/schema_msg.h                 | 25 ++++++--
 5 files changed, 102 insertions(+), 16 deletions(-)

